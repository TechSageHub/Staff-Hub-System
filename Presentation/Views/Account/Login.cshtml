@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["AuthMode"] = "Login";
    Layout = "_AuthLayout";
}

<div class="split-login-container">
    <!-- Left Hero Pane (Indigo / Navy Gradient) -->
    <section class="split-login-hero" aria-label="Branding and overview">
        <!-- Top Left Brand Badge -->
        <div class="split-login-brand-wrapper">
            <a href="/" class="split-login-brand">
                <span class="split-login-brand-logo">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
                <span class="split-login-brand-title">StaffHub - HRMS</span>
            </a>
        </div>

        <!-- Center Hero Content -->
        <div class="split-login-hero-center">
            <div class="split-login-badge-disc" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
            </div>

            <h1 class="split-login-hero-h1">
                StaffHub Human Resource<br />Management System
            </h1>

            <p class="split-login-hero-desc">
                Streamline your workforce workflow. Submit, track, and manage employee operations all in one place.
            </p>

            <div class="split-login-feature-list">
                <div class="split-login-feature-item">
                    <span class="split-login-feature-icon"><i class="bi bi-check-circle"></i></span>
                    <span>Submit employee requests effortlessly</span>
                </div>
                <div class="split-login-feature-item">
                    <span class="split-login-feature-icon"><i class="bi bi-book"></i></span>
                    <span>Track deadlines, leaves, and records</span>
                </div>
                <div class="split-login-feature-item">
                    <span class="split-login-feature-icon"><i class="bi bi-people"></i></span>
                    <span>Collaborate across teams and departments</span>
                </div>
            </div>
        </div>

        <!-- Bottom Left Footer -->
        <div class="split-login-hero-footer">
            &copy; @DateTime.Now.Year StaffHub. All rights reserved.
        </div>
    </section>

    <!-- Right Form Pane (Clean elevated card) -->
    <section class="split-login-form-pane" aria-label="Sign in form">
        <a asp-controller="Home" asp-action="Index" class="split-login-back">
            <i class="bi bi-arrow-left"></i> Back to home
        </a>
        <button type="button" class="split-login-theme-toggle" data-sh-theme-toggle aria-pressed="false" aria-label="Toggle theme" title="Toggle theme">
            <i class="bi bi-moon-stars"></i>
        </button>

        <div class="split-login-card">
            <div class="split-login-card-header">
                <h2>Welcome back</h2>
                <p>Sign in to your account to continue</p>
            </div>

            <form asp-action="Login" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3 small" role="alert" style="@(ViewContext.ModelState.IsValid ? "display:none;" : "")"></div>

                <div class="split-login-form-group">
                    <label asp-for="Email" class="split-login-label">Email or Username</label>
                    <input asp-for="Email" class="split-login-input" placeholder="name@company.com" autocomplete="username" required />
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="split-login-form-group">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="split-login-label mb-0">Password</label>
                        <a asp-action="ForgotPassword" class="split-login-forgot-link">Forgot password?</a>
                    </div>
                    <div class="split-login-input-wrap">
                        <input asp-for="Password" type="password" id="loginPassword" class="split-login-input" placeholder="••••••••••••" autocomplete="current-password" required />
                        <button type="button" class="split-login-eye-btn" data-sh-toggle-password="#loginPassword" tabindex="-1" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="split-login-meta-row">
                    <div class="form-check mb-0">
                        <input asp-for="RememberMe" class="form-check-input" id="loginRememberMe" />
                        <label asp-for="RememberMe" class="form-check-label small" for="loginRememberMe" style="color: var(--sh-text-muted, #64748b);">
                            Keep me signed in
                        </label>
                    </div>
                </div>

                <button type="submit" class="split-login-btn">
                    <span>Sign In</span> <i class="bi bi-arrow-right"></i>
                </button>

                <div class="split-login-card-footer">
                    <span>Don't have an account?</span>
                    <a asp-action="Register" class="split-login-admin-link">Contact your administrator</a>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
